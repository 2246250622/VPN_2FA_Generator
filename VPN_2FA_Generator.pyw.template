def generate_code(name):
    acc = accounts.get(name, {})
    raw_secret = str(acc.get("secret", "")).strip()
    if not raw_secret:
        alert_message.configure(text=f"❌ {name} 未填 Secret，請到 Settings", text_color="red")
        return

    if name == "CyberArk":
        prefix = ent_ca_prefix.get()
        if not str(prefix).strip():
            alert_message.configure(text="❌ CyberArk 必須輸入今次 Prefix", text_color="red")
            ent_ca_prefix.focus()
            return
        persist_ca_prefix()
    else:
        prefix = str(acc.get("prefix", ""))

    try:
        final = prefix + totp_now(raw_secret)
        pyperclip.copy(final)
        alert_message.configure(text=f"✓ 已複製 {name}（長度 {len(final)}）", text_color="lime")
    except Exception as e:
        alert_message.configure(text=f"產生失敗：{e}", text_color="red")


