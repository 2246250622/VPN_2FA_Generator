B32_BODY = re.compile(r"^[A-Z2-7]+$")
HEX_BODY = re.compile(r"^[0-9A-F]+$")


def extract_secret(raw: str) -> str:
    s = (raw or "").strip().strip('"').strip("'")
    if s.lower().startswith("otpauth://"):
        s = (parse_qs(urlparse(s).query).get("secret") or [""])[0]
    return re.sub(r"[\s\-]+", "", s).upper()


def totp_from_b32(body: str) -> str:
    body = body.rstrip("=")
    pad = (-len(body)) % 8
    return pyotp.TOTP(body + ("=" * pad)).now()


def totp_from_hex(body: str) -> str:
    if len(body) % 2:
        body = "0" + body
    raw = bytes.fromhex(body)
    return pyotp.TOTP(base64.b32encode(raw).decode("ascii")).now()


def totp_now(raw_secret: str) -> str:
    s = extract_secret(raw_secret)
    if not s:
        raise ValueError("Secret 空白")

    body = s.rstrip("=")
    errors = []

    if B32_BODY.fullmatch(body):
        try:
            return totp_from_b32(body)
        except Exception as e:
            errors.append(f"Base32: {e}")

    if HEX_BODY.fullmatch(body) and len(body) >= 10:
        try:
            return totp_from_hex(body)
        except Exception as e:
            errors.append(f"Hex: {e}")

    mapped = body.translate(str.maketrans({"0": "O", "1": "I", "8": "B"}))
    if mapped != body and B32_BODY.fullmatch(mapped):
        try:
            return totp_from_b32(mapped)
        except Exception as e:
            errors.append(f"Mapped: {e}")

    raise ValueError("無法解碼 Secret（已試 Base32 / Hex / 0-1-8 對應）。" + (
        " " + " | ".join(errors) if errors else ""
    ))


def _normalize_accounts(raw, legacy_prefix=""):
    accounts = json.loads(json.dumps(DEFAULT_ACCOUNTS))
    if not isinstance(raw, dict):
        return accounts
    for name, val in raw.items():
        if isinstance(val, dict):
            accounts[name] = {
                "secret": str(val.get("secret", "")).strip(),
                "prefix": str(val.get("prefix", "")),
            }
        else:
            accounts[name] = {
                "secret": str(val).strip(),
                "prefix": str(legacy_prefix) if name != "CyberArk" else "",
            }
    return accounts


def save_config(cfg):
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)


def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            data["accounts"] = _normalize_accounts(
                data.get("accounts", {}), data.get("prefix", "")
            )
            data.pop("prefix", None)
            data.setdefault("appearance_mode", "dark")
            save_config(data)
            return data
        except Exception:
            pass
    save_config(DEFAULT_CONFIG)
    return json.loads(json.dumps(DEFAULT_CONFIG))


