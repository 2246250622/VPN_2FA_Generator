            }
        else:
            new_accounts[name] = {
                "prefix": ent_ca_prefix.get(),
                "secret": secret,
            }
    config["accounts"] = new_accounts
    accounts = new_accounts
    save_config(config)
    refresh_buttons()
    alert_message.configure(text="✓ 設定已儲存", text_color="green")
